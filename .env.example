# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: Optional for local development (uses local store by default),
# but RECOMMENDED for production/hosting (e.g. Supabase, Neon, Railway).
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
# Contoh: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# OWNER_EMAIL: Optional Google account email authorized to approve guestbook notes
# and edit archive entries. If omitted, the first signed-in owner claims admin access.
OWNER_EMAIL=
